{{ 'dtf.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    if collection.title != blank
      assign heading = collection.title
    elsif page.title != blank
      assign heading = page.title
    endif
  endif
  assign stickers = section.settings.stickers | split: ','
-%}
<section class="dtf dtf-page-hero" style="--dtf-bg: {{ section.settings.background }}">
  <div class="dtf-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <span class="dtf-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1>{{ heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="dtf-lead">{{ section.settings.text }}</div>
    {%- endif -%}
    <div class="dtf-floaters" aria-hidden="true">
      {%- for name in stickers -%}
        <img
          class="dtf-floater dtf-floater--{{ forloop.index }}"
          src="{{ 'dtf-design-' | append: name | strip | append: '.svg' | asset_url }}"
          alt=""
          width="100"
          height="100"
        >
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gang sheet page header",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page or collection title." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffd60a" },
    {
      "type": "text",
      "id": "stickers",
      "label": "Stickers",
      "info": "Up to 4, separated by commas: sunset, daisy, bolt, smiley, star, heart, wave, flame, badge",
      "default": "star,daisy,bolt,heart"
    }
  ],
  "presets": [{ "name": "Gang sheet page header" }]
}
{% endschema %}
