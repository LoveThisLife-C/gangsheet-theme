{{ 'dtf.css' | asset_url | stylesheet_tag }}

{%- assign columns = section.blocks.size | at_most: 3 | at_least: 1 -%}
<section class="dtf" style="--dtf-bg: {{ section.settings.background }}; --dtf-cols: {{ columns }}">
  <div class="dtf-wrap">
    <div class="dtf-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div>{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="dtf-cards">
      {%- for block in section.blocks -%}
        <div class="dtf-card{% if block.settings.image != blank %} dtf-card--photo{% endif %}" {{ block.shopify_attributes }}>
          <div class="dtf-card__art">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 380px, 90vw' }}
            {%- else -%}
              <img src="{{ 'dtf-icon-' | append: block.settings.icon | append: '.svg' | asset_url }}" alt="" width="120" height="120" loading="lazy">
            {%- endif -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          {{ block.settings.text }}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gang sheet features",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why order here" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f2ea" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Illustration",
          "options": [
            { "value": "upload", "label": "Upload" },
            { "value": "arrange", "label": "Arrange" },
            { "value": "dpi", "label": "Print quality" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "pickup", "label": "Shop" },
            { "value": "ship", "label": "Box" }
          ],
          "default": "upload"
        },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Optional. Replaces the illustration." },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the feature.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Gang sheet features" }]
}
{% endschema %}
