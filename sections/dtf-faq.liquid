{{ 'dtf.css' | asset_url | stylesheet_tag }}

<section class="dtf" id="faq" style="--dtf-bg: {{ section.settings.background }}">
  <div class="dtf-wrap dtf-faq">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {{ section.settings.text }}
      <img class="dtf-faq__sticker" src="{{ 'dtf-design-smiley.svg' | asset_url }}" alt="" width="140" height="140" loading="lazy">
    </div>
    <div class="dtf-faq__list">
      {%- for block in section.blocks -%}
        <details class="dtf-q" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.question }}<span aria-hidden="true"></span></summary>
          <div class="dtf-q__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gang sheet FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Can't find your answer? <a href=\"/pages/contact\">Contact us</a>.</p>" },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Gang sheet FAQ" }]
}
{% endschema %}
