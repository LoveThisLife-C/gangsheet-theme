{{ 'dtf.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_file != blank
    assign has_video = true
  endif
-%}
<section class="dtf dtf-hero{% if has_video %} dtf-hero--video{% endif %}">
  {%- if has_video -%}
    <div class="dtf-hero__bg" aria-hidden="true">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, image_size: '1600x'
        }}
      {%- else -%}
        {%- liquid
          assign wide_src = section.settings.video_file | asset_url
          assign wide_poster = section.settings.video_poster | asset_url
          assign tall_src = wide_src
          assign tall_poster = wide_poster
          if section.settings.video_file_mobile != blank
            assign tall_src = section.settings.video_file_mobile | asset_url
            assign tall_poster = section.settings.video_poster_mobile | asset_url
          endif
        -%}
        <video
          data-wide="{{ wide_src }}"
          data-tall="{{ tall_src }}"
          data-wide-poster="{{ wide_poster }}"
          data-tall-poster="{{ tall_poster }}"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        ></video>
        <script>
          (function (v) {
            var tall = window.matchMedia('(max-aspect-ratio: 1/1)').matches;
            v.poster = tall ? v.dataset.tallPoster : v.dataset.widePoster;
            v.src = tall ? v.dataset.tall : v.dataset.wide;
            v.muted = true;
            var p = v.play && v.play();
            if (p && p.catch) p.catch(function () {});
          })(document.currentScript.previousElementSibling);
        </script>
      {%- endif -%}
    </div>
    <div class="dtf-hero__shade" aria-hidden="true"></div>
  {%- endif -%}
  <div class="dtf-wrap">
    <div class="dtf-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="dtf-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      <div class="dtf-lead">{{ section.settings.text }}</div>
      <div class="dtf-actions">
        {%- if section.settings.button_label != blank -%}
          <a class="dtf-btn dtf-btn--primary" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label -}}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="dtf-btn" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.price_amount != blank -%}
        <p class="dtf-price-note">
          <strong>{{ section.settings.price_amount }}</strong>{{ section.settings.price_text }}
        </p>
      {%- endif -%}
    </div>

    {%- if has_video -%}
      {%- if section.settings.sticker_big != blank -%}
        <span class="dtf-sticker dtf-hero__sticker" aria-hidden="true">
          <span>{{ section.settings.sticker_big }}<small>{{ section.settings.sticker_small }}</small></span>
        </span>
      {%- endif -%}
    {%- else -%}
      <div class="dtf-collage">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: class: 'dtf-collage__photo', sizes: '(min-width: 900px) 520px, 90vw', loading: 'eager'
          }}
        {%- else -%}
          <img class="dtf-collage__sheet" src="{{ 'dtf-sheet.svg' | asset_url }}" alt="A gang sheet packed with colorful designs" width="440" height="560" loading="eager">
          <img class="dtf-collage__tee" src="{{ 'dtf-tee.svg' | asset_url }}" alt="T-shirt printed with a sunset design" width="240" height="240">
          <img class="dtf-floater dtf-floater--hero1" src="{{ 'dtf-design-star.svg' | asset_url }}" alt="" width="100" height="100" aria-hidden="true">
          <img class="dtf-floater dtf-floater--hero2" src="{{ 'dtf-design-flame.svg' | asset_url }}" alt="" width="100" height="100" aria-hidden="true">
        {%- endif -%}
        {%- if section.settings.sticker_big != blank -%}
          <span class="dtf-sticker" aria-hidden="true">
            <span>{{ section.settings.sticker_big }}<small>{{ section.settings.sticker_small }}</small></span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gang sheet hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "DTF transfers · Midlothian, VA" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Print it all. Pay by the foot." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Upload your designs, arrange them on 22\" wide DTF film, and pay only for the length you use. Every sheet prints at 300 DPI.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Main button label", "default": "Build your gang sheet" },
    { "type": "text", "id": "button_link", "label": "Main button link", "default": "/apps/gangsheet/build" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Sizes & pricing" },
    { "type": "text", "id": "button2_link", "label": "Second button link", "default": "/apps/gangsheet" },
    { "type": "text", "id": "price_amount", "label": "Price highlight", "default": "$3.80/ft" },
    { "type": "text", "id": "price_text", "label": "Price note", "default": "for 100+ ft orders. Pickup or UPS shipping." },
    { "type": "text", "id": "sticker_big", "label": "Sticker big text", "default": "300" },
    { "type": "text", "id": "sticker_small", "label": "Sticker small text", "default": "DPI print" },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. Upload your own background video to replace the built-in printer video."
    },
    { "type": "text", "id": "video_file", "label": "Built-in background video (wide screens)", "default": "dtf-hero-wide.mp4", "info": "Theme asset name. Clear it to show the photo or illustration instead." },
    { "type": "text", "id": "video_poster", "label": "Built-in video poster (wide screens)", "default": "dtf-hero-wide-poster.jpg" },
    { "type": "text", "id": "video_file_mobile", "label": "Built-in background video (phones)", "default": "dtf-hero.mp4" },
    { "type": "text", "id": "video_poster_mobile", "label": "Built-in video poster (phones)", "default": "dtf-hero-poster.jpg" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Optional. Replaces the illustration. A portrait photo of your prints works best."
    }
  ],
  "presets": [{ "name": "Gang sheet hero" }]
}
{% endschema %}
