{{ 'dtf.css' | asset_url | stylesheet_tag }}

<section class="dtf" style="--dtf-bg: {{ section.settings.background }}">
  <div class="dtf-wrap dtf-wrap--tight">
    <div class="dtf-contact">
      <div class="dtf-contact__info">
        {%- for block in section.blocks -%}
          <div class="dtf-info" {{ block.shopify_attributes }}>
            <img src="{{ 'dtf-icon-' | append: block.settings.icon | append: '.svg' | asset_url }}" alt="" width="64" height="64" loading="lazy">
            <div>
              <h3>{{ block.settings.title }}</h3>
              {{ block.settings.text }}
            </div>
          </div>
        {%- endfor -%}
        {%- if section.settings.map_address != blank -%}
          <div class="dtf-map">
            <iframe
              title="Map to {{ section.settings.map_address | escape }}"
              src="https://maps.google.com/maps?q={{ section.settings.map_address | url_encode }}&z=14&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        {%- endif -%}
      </div>

      <div class="dtf-form-card">
        <h2>{{ section.settings.form_heading }}</h2>
        {%- form 'contact', id: 'DtfContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="dtf-form-success" role="status">{{ section.settings.success_message }}</p>
          {%- elsif form.errors -%}
            <div class="dtf-form-error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="dtf-fields">
            <label class="dtf-field">
              <span>Name</span>
              <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
            </label>
            <label class="dtf-field">
              <span>Email <em>*</em></span>
              <input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
            </label>
            <label class="dtf-field">
              <span>Phone</span>
              <input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </label>
            <label class="dtf-field">
              <span>Order number</span>
              <input type="text" name="contact[order number]" placeholder="#1001">
            </label>
            <label class="dtf-field dtf-field--full">
              <span>Message <em>*</em></span>
              <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
            </label>
          </div>
          <button type="submit" class="dtf-btn dtf-btn--primary">{{ section.settings.button_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gang sheet contact",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f2ea" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks! We'll get back to you soon." },
    { "type": "text", "id": "map_address", "label": "Map address", "info": "Leave blank to hide the map.", "default": "10920 Hull Street Rd, Midlothian, VA 23112" }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Illustration",
          "options": [
            { "value": "pickup", "label": "Shop" },
            { "value": "ship", "label": "Box" },
            { "value": "upload", "label": "Upload" },
            { "value": "arrange", "label": "Arrange" },
            { "value": "dpi", "label": "Print quality" },
            { "value": "ruler", "label": "Ruler" }
          ],
          "default": "pickup"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Visit us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add details here.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Gang sheet contact" }]
}
{% endschema %}
